# ==============================================================================
# Repz — Class Representative Attendance Management Environment Variables
# ==============================================================================

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public API Key (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Google Calendar API / OAuth Client ID (if using direct REST API synchronization)
# Note: Google Calendar deep template intents operate universally without requiring this key.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com


